# FlyChat 服务端配置
# 复制此文件为 .env 并填入你的 API Key（Key 只保存在服务端，前端不会接触）

# ============================================================
# 模型服务商（填了 Key 才会出现在前端「设置 → 模型选择」里）
# 也可以完全不填，改为在网页「设置 → 模型服务」里添加
# ============================================================

# OpenAI 兼容接口（OpenAI 官方或任何兼容服务）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek（OpenAI 兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=
# 可选：自定义网关地址
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Google Gemini
GEMINI_API_KEY=

# Kimi (Moonshot，OpenAI 兼容)
KIMI_API_KEY=
# GLM (智谱，OpenAI 兼容)
GLM_API_KEY=
# 通义千问（DashScope 兼容模式）
QWEN_API_KEY=
# 豆包（火山方舟，模型名填推理接入点 ID）
DOUBAO_API_KEY=
# 硅基流动
SILICONFLOW_API_KEY=
# Groq
GROQ_API_KEY=
# OpenRouter（聚合网关）
OPENROUTER_API_KEY=

# 覆盖某服务商的模型列表（逗号分隔），优先级：网页配置 > 本变量 > 内置默认
# OPENAI_MODELS=gpt-4o,gpt-4o-mini

# Ollama 本地模型（无需 Key，填了 BASE_URL 即可用）
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ============================================================
# 联网搜索（任选其一；配置后前端才会出现「联网搜索」开关）
# ============================================================
# Tavily（https://tavily.com，专为 LLM 设计，推荐）
TAVILY_API_KEY=
# Brave Search API
# BRAVE_API_KEY=
# Serper（Google 结果）
# SERPER_API_KEY=
# 自建 SearXNG（内网可用）
# SEARXNG_URL=http://127.0.0.1:8080
# 强制指定搜索后端：tavily | brave | serper | searxng（默认 auto 按优先级自动选）
# SEARCH_PROVIDER=auto

# ============================================================
# 服务与安全
# ============================================================
PORT=3001
# 默认只监听本机；要局域网访问改成 0.0.0.0（务必同时设置下面的访问令牌）
HOST=127.0.0.1

# 访问令牌：设置后除 /api/health、/api/config、/api/metrics 外都需要
# Authorization: Bearer <token> 或 X-FlyChat-Token 头
# 暴露到公网时**必须**设置
# FLYCHAT_ACCESS_TOKEN=

# ============================================================
# 多用户（团队用）
# ============================================================
# 开启后所有 /api 与 /v1 都要求登录，会话按用户隔离；
# 第一次打开网页会进入「创建管理员」页（不预置默认账号）。
# 关闭时与以前完全一致：不鉴权、不隔离，适合个人自用。
# MULTI_USER=true
# 登录态有效期（天）
# SESSION_DAYS=30

# 允许跨域的前端来源（逗号分隔）。留空=不限制，仅建议本机开发时留空
# CORS_ORIGINS=https://chat.example.com

# 部署在 nginx / Cloudflare 之后时设为 1，才能拿到真实客户端 IP（限流依赖它）
# TRUST_PROXY=1

# 严格 SSRF 模式：禁止把自定义服务商的 Base URL 指向回环/内网地址
# （默认允许，因为 Ollama、局域网网关是常见用法）
# STRICT_SSRF=1

# ============================================================
# 上游弹性（一般不用改）
# ============================================================
# 单次上游请求超时（毫秒）
# UPSTREAM_TIMEOUT_MS=600000
# 上游 429/5xx 的自动重试次数（仅在还没输出任何内容前重试）
# UPSTREAM_RETRIES=2
# 重试退避基数 / 上限（毫秒）
# UPSTREAM_RETRY_BASE_MS=400
# UPSTREAM_RETRY_MAX_MS=8000
# 单个服务商的并发流上限
# UPSTREAM_CONCURRENCY=6
# 连续失败多少次后熔断、熔断冷却时间（毫秒）
# BREAKER_THRESHOLD=5
# BREAKER_COOLDOWN_MS=30000
# SSE 心跳间隔（毫秒），防止反代掐断长连接
# SSE_HEARTBEAT_MS=15000

# ============================================================
# 知识库（RAG）—— 需要一个支持 /embeddings 的 OpenAI 兼容服务商
# ============================================================
# 用哪个服务商做向量化（留空则自动选第一个 OpenAI 兼容服务商）
# EMBEDDING_PROVIDER=openai
# 向量模型（默认 text-embedding-3-small；Ollama 下默认 nomic-embed-text）
# EMBEDDING_MODEL=text-embedding-3-small
# 文档入库并发（默认 2，上限 8）。调高会更快，但可能触发 embedding 服务限流
# INGEST_CONCURRENCY=2

# ============================================================
# 模型降级链：主模型重试耗尽后按顺序切换（只在还没输出内容时切换）
# 例：FALLBACK_MODELS=deepseek:deepseek-chat,openai:gpt-4o-mini
# ============================================================
# FALLBACK_MODELS=

# ============================================================
# 上下文预算与摘要压缩
# ============================================================
# 超窗口自动裁剪；裁剪前先用小模型总结被丢弃的历史，避免「长对话失忆」
# CONTEXT_BUDGET=true
# CONTEXT_COMPACT=true
# CONTEXT_MIN_KEEP=4
# 做摘要的小模型（留空则自动在已配置服务商里挑便宜的）
# SUMMARY_MODEL=openai:gpt-4o-mini

# ============================================================
# 子任务专用模型（标题 / 摘要 / 追问建议）
# 不配也行：会自动挑名字带 mini/flash/haiku 的便宜模型，避免用主模型干小活
# 格式：`服务商ID:模型名`，或只写模型名（会在已配置服务商里找持有它的那个）
# ============================================================
# TITLE_MODEL=deepseek:deepseek-chat
# SUGGEST_MODEL=deepseek:deepseek-chat

# ============================================================
# 存储与日志
# ============================================================
# 服务端持久化：auto（默认，有 SQLite 就用）| sqlite | off
# FLYCHAT_STORAGE=auto
# 数据目录（数据库、自定义服务商配置、模型目录覆盖）
# FLYCHAT_DATA_DIR=./server/data
# 日志级别：debug | info | warn | error | silent
# LOG_LEVEL=info
# 日志格式：pretty（本机可读）| json（容器采集）
# LOG_FORMAT=json
