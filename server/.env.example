# FlyChat 服务端配置
# 复制此文件为 .env 并填入你的 API Key（Key 只保存在服务端，前端不会接触）

# OpenAI 兼容接口（OpenAI 官方或任何兼容服务）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek（OpenAI 兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# 服务端口
PORT=3001
